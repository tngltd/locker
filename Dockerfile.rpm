# Dockerfile for building RPM packages
FROM quay.io/centos/centos:stream9

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Install system dependencies
RUN dnf update -y && dnf install -y \
    python3 \
    python3-pip \
    python3-devel \
    python3-setuptools \
    python3-wheel \
    gcc \
    gcc-c++ \
    make \
    rpm-build \
    rpmdevtools \
    git \
    curl \
    && dnf clean all

# Create build user
RUN useradd -m -s /bin/bash builder

# Set up RPM build environment for builder user
USER builder
WORKDIR /home/builder

# Create RPM build directory structure
RUN mkdir -p rpmbuild/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS}

# Set up RPM macros
RUN echo '%_topdir /home/builder/rpmbuild' > ~/.rpmmacros

# Install Python build tools
RUN pip3 install --user --upgrade pip setuptools wheel build twine

# Add user's pip bin to PATH
ENV PATH="/home/builder/.local/bin:${PATH}"

# Set working directory for builds
WORKDIR /home/builder/build

# Default command
CMD ["/bin/bash"]
