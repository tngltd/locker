{
  "service": {
    "name": "lock-service",
    "version": "1.0.0",
    "log_level": "INFO",
    "log_file": "/var/log/lock-service.log",
    "pid_file": "/var/run/lock-service.pid",
    "config_file": "/etc/lock-service/config.json"
  },
  "network": {
    "usb_interface": "usb0",
    "blocked_interfaces": ["eth0", "wlan0", "wifi0"],
    "allowed_ports": [],
    "blocked_ports": [22, 23, 80, 443, 8080, 8443]
  },
  "monitoring": {
    "check_interval_seconds": 5
  },
  "logging": {
    "verbose": true,
    "include_device_info": true,
    "external_logging": {
      "enabled": false,
      "elasticsearch_url": "",
      "logstash_url": "",
      "syslog_server": ""
    }
  }
}
