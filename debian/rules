#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output:
#   dh $@ --with python3

export DH_PYTHON_INTERPRETER=python3
export PYBUILD_SYSTEM=pyproject
export DEB_BUILD_OPTIONS=nocheck

%:
	dh $@ --with python3 --buildsystem=pybuild

# Let dh_python3 handle the Python package installation
# It will read pyproject.toml and install the package with entry points

override_dh_auto_install:
	# Let pybuild install the Python package first (with entry points)
	dh_auto_install
	
	# Copy package to common location so all Python 3.x versions can find it
	# This ensures compatibility when system default python3 is different from build version
	@if [ -d debian/locker/usr/lib/python3.*/dist-packages/locker ]; then \
		mkdir -p debian/locker/usr/lib/python3/dist-packages; \
		cp -r debian/locker/usr/lib/python3.*/dist-packages/locker* debian/locker/usr/lib/python3/dist-packages/ 2>/dev/null || true; \
	fi
	
	# Then install additional configuration files
	install -d $(CURDIR)/debian/locker/etc/locker
	install -m 644 $(CURDIR)/config/config.json $(CURDIR)/debian/locker/etc/locker/config.json
	
	# Install systemd service file
	install -d $(CURDIR)/debian/locker/etc/systemd/system
	install -m 644 $(CURDIR)/config/locker.service $(CURDIR)/debian/locker/etc/systemd/system/
	
	# Install documentation
	install -d $(CURDIR)/debian/locker/usr/share/doc/locker
	install -d $(CURDIR)/debian/locker/usr/share/locker/docs
	install -m 644 $(CURDIR)/docs/documentation.html $(CURDIR)/debian/locker/usr/share/locker/docs/ 2>/dev/null || true
	
	# Install scripts (if they exist)
	install -d $(CURDIR)/debian/locker/usr/share/locker/scripts
	[ -f $(CURDIR)/scripts/install.sh ] && install -m 755 $(CURDIR)/scripts/install.sh $(CURDIR)/debian/locker/usr/share/locker/scripts/ || true
	[ -f $(CURDIR)/scripts/setup.sh ] && install -m 755 $(CURDIR)/scripts/setup.sh $(CURDIR)/debian/locker/usr/share/locker/scripts/ || true
	[ -f $(CURDIR)/scripts/uninstall.sh ] && install -m 755 $(CURDIR)/scripts/uninstall.sh $(CURDIR)/debian/locker/usr/share/locker/scripts/ || true

override_dh_installdocs:
	# Documentation is installed in override_dh_auto_install
	:

override_dh_python3:
	# Let dh_python3 handle the Python package installation
	# It will use pyproject.toml to install the package with entry points
	dh_python3
