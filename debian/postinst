#!/bin/bash
set -e

# Post-installation script for locker

# Ensure configuration directory exists with proper permissions
CONFIG_DIR="/etc/locker"
CONFIG_FILE="$CONFIG_DIR/config.json"
mkdir -p "$CONFIG_DIR"
chmod 775 "$CONFIG_DIR"  # Allow group write
chown root:locker "$CONFIG_DIR"

# Ensure configuration file exists
if [ ! -f "$CONFIG_FILE" ]; then
    echo "Creating default configuration file at $CONFIG_FILE"
    
    # Copy from package-installed template
    PACKAGE_CONFIG="/usr/share/locker/config.json"
    if [ -f "$PACKAGE_CONFIG" ]; then
        cp "$PACKAGE_CONFIG" "$CONFIG_FILE"
        chmod 664 "$CONFIG_FILE"  # Allow group write
        chown root:locker "$CONFIG_FILE"
        echo "Default configuration file copied from package template."
    else
        echo "Error: Package config template not found at $PACKAGE_CONFIG"
        exit 1
    fi
else
    # Ensure existing config file has proper permissions
    chmod 664 "$CONFIG_FILE"  # Allow group write
    chown root:locker "$CONFIG_FILE"
fi

# Check lockerd executable exists; if not, report an error to diagnose packaging/build issue
if [ ! -f /usr/bin/lockerd ]; then
    echo "ERROR: /usr/bin/lockerd not found after installation." >&2
    echo "This indicates a packaging or build problem. Please check your package installation." >&2
    exit 1
fi

# Verify locker executable exists
if [ ! -f /usr/bin/locker ]; then
    echo "ERROR: /usr/bin/locker not found after installation." >&2
    echo "This indicates a packaging or build problem. Please check your package installation." >&2
    exit 1
fi

# Reload systemd (only if systemd is running)
if command -v systemctl >/dev/null 2>&1; then
    # Check if systemd is actually running
    if systemctl is-system-running >/dev/null 2>&1; then
        systemctl daemon-reload
        
        # Enable and start the service
        if systemctl enable locker; then
            echo "Service enabled successfully."
        else
            echo "Warning: Failed to enable service."
        fi
        
        # systemctl start waits for the start job to complete (no sleep needed)
        if systemctl start locker; then
            echo "Service started successfully."
        else
            echo "Warning: Failed to start service. Check logs with: systemctl status locker" >&2
            systemctl status locker --no-pager -l 2>&1 || true
        fi
    elif [ -d /run/systemd/system ]; then
        # Systemd is installed but is-system-running may have failed (e.g. container, init)
        # Enable and try to start anyway so the service runs when possible
        systemctl daemon-reload 2>/dev/null || true
        systemctl enable locker 2>/dev/null || true
        if systemctl start locker 2>/dev/null; then
            echo "Service started successfully."
        else
            echo "Note: Service enabled but could not start now (e.g. systemd not fully running)."
            echo "To start manually: systemctl start locker"
            echo "Or run directly: lockerd"
        fi
    else
        echo "Note: Systemd not available. Service must be started manually."
        echo "To start: lockerd"
    fi
else
    echo "Note: Systemd not installed. Service must be started manually."
    echo "To start: lockerd"
fi

# If systemctl is available and service is enabled but not active, try start once (e.g. after install on a running system)
if command -v systemctl >/dev/null 2>&1; then
    if systemctl is-enabled locker >/dev/null 2>&1 && ! systemctl is-active --quiet locker 2>/dev/null; then
        if systemctl start locker 2>/dev/null; then
            echo "Service started successfully."
        fi
    fi
fi

# Ensure log directory exists and create log file with proper permissions
LOG_FILE="/var/log/locker.log"
if [ ! -f "$LOG_FILE" ]; then
    echo "Creating log file at $LOG_FILE"
    touch "$LOG_FILE"
    chmod 644 "$LOG_FILE"
    chown root:root "$LOG_FILE"
    echo "Log file created."
fi

# Create log rotation configuration
cat > /etc/logrotate.d/locker << 'EOF'
/var/log/locker.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    create 644 root root
    postrotate
        systemctl reload locker > /dev/null 2>&1 || true
    endscript
}
EOF


echo "Locker installed successfully."
if command -v systemctl >/dev/null 2>&1 && systemctl is-system-running >/dev/null 2>&1; then
    echo "The service has been enabled and started."
else
    echo "The service has been installed but not started (systemd not running)."
    echo "To start the service:"
    echo "  - With systemd: systemctl start locker"
    echo "  - Directly: lockerd"
fi
echo "Next steps:"
if [ -n "$INSTALL_USER" ] && id "$INSTALL_USER" > /dev/null 2>&1; then
    echo "  Note: User $INSTALL_USER has been added to the 'locker' group."
    echo "        You can run locker commands without sudo after logging out and back in,"
    echo "        or by running: newgrp locker"
    echo ""
fi
echo "  1. Run 'locker set-android-serial' to configure an Android device"
echo "     (or 'locker list-devices' to see connected devices first)"
echo "  2. Run 'locker add-service <service>' to configure services to manage"
echo "  3. Run 'locker set-mode enforcing' to enable locking"
if command -v systemctl >/dev/null 2>&1; then
    echo "  4. Check service status with 'systemctl status locker'"
else
    echo "  4. Check logs with 'locker logs'"
fi

#DEBHELPER#
