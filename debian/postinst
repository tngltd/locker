#!/bin/bash
set -e

# Post-installation script for lock-service

# Reload systemd (only if systemd is running)
if command -v systemctl >/dev/null 2>&1 && systemctl is-system-running >/dev/null 2>&1; then
    systemctl daemon-reload
    
    # Enable and start the service
    systemctl enable lock-service || true
    systemctl start lock-service || true
elif [ -d /run/systemd/system ]; then
    # Systemd is installed but not running (e.g., in Docker)
    # Just create the service file, it will be enabled on next boot
    :
fi

# Create log rotation configuration
cat > /etc/logrotate.d/lock-service << 'EOF'
/var/log/lock-service.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    create 644 root root
    postrotate
        systemctl reload lock-service > /dev/null 2>&1 || true
    endscript
}
EOF


echo "Lock-service installed successfully."
echo "The service has been enabled and started."
echo "Next steps:"
echo "  1. Run 'lock-cli get-android-serial' to see connected devices"
echo "  2. Run 'lock-cli set-android-serial' to configure an Android device"
echo "  3. Run 'lock-cli add-service <service> stop|start' to configure services"
echo "  4. Run 'lock-cli set-mode enforcing' to enable locking"
echo "  5. Check service status with 'systemctl status lock-service'"

#DEBHELPER#
